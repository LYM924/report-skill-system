# 数据库（容器部署用容器服务名，本机开发用 localhost）
DATABASE_URL=postgresql+asyncpg://kb_user:kb_pass@postgres:5432/knowledge_base
DATABASE_URL_SYNC=postgresql+psycopg2://kb_user:kb_pass@postgres:5432/knowledge_base

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-base

# JWT（生产环境务必替换为随机密钥）
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 管理员账号（首次启动自动创建）
ADMIN_USER=admin
ADMIN_PASS=change-me-in-production

# AI API（留空 = 使用启动 shell 的环境变量）
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# 存储模式: local | minio
STORAGE_BACKEND=local
DATA_DIR=/app/data
